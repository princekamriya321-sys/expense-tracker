<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Expense</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1>Add New Expense</h1>
        <p>Enter the details of your expense.</p>
    </header>

    <main>
        <section class="expense-form">
            <% if (errors && errors.length > 0) { %>
    <div class="error-message">
        <% errors.forEach(error => { %>
            <p><%= error %></p>
        <% }) %>
    </div>
<% } %>
            <form action="/expenses" method="POST">
                <div class="form-group">
                    <label for="description">Description</label>
                    <input
                        type="text"
                        id="description"
                        name="expense[description]"
                        placeholder="e.g. Lunch with friends"
                        value="<%= formData.description || '' %>"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="amount">Amount (₹)</label>
                    <input
                        type="number"
                        id="amount"
                        name="expense[amount]"
                        min="0.01"
                        step="0.01"
                        value="<%= formData.amount ?? '' %>"
                        placeholder="e.g. 350"
                        required
                    >
                </div>

                    <div class="form-group">
            <label for="category">Category</label>
            <select id="category" name="expense[category]" required>
             <option value="Food" <%= formData.category === "Food" ? "selected" : "" %>>Food</option>
            <option value="Transport" <%= formData.category === "Transport" ? "selected" : "" %>>Transport</option>
            <option value="Shopping" <%= formData.category === "Shopping" ? "selected" : "" %>>Shopping</option>
            <option value="Bills" <%= formData.category === "Bills" ? "selected" : "" %>>Bills</option>
            <option value="Entertainment" <%= formData.category === "Entertainment" ? "selected" : "" %>>Entertainment</option>
            <option value="Other" <%= formData.category === "Other" ? "selected" : "" %>>Other</option>
                        </select>
        </div>
                <div class="form-group">
                    <label for="date">Date</label>
                    <input
                        type="date"
                        id="date"
                        name="expense[date]"
                        required
                        value="<%= formData.date ? new Date(formData.date).toISOString().slice(0, 10) : '' %>"
                    >
                </div>

                <div class="form-group">
                <label for="notes">Notes (optional)</label>
                <textarea
                    id="notes"
                    name="expense[notes]"
                    placeholder="Add extra details..."
                ><%= formData.notes || '' %></textarea>
            </div>
                <button type="submit" class="add-btn">Save Expense</button>
                <a href="/" class="cancel-btn">Cancel</a>
            </form>
        </section>
    </main>
</body>
</html>